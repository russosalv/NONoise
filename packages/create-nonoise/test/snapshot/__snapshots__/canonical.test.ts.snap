  },
  "keywords": [
    "nonoise",
    "azure-devops",
    "work-items",
    "sprint",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "description": "CLI that pushes sprint work-item breakdowns (Feature > User Story > Task) to Azure DevOps. Reads JSON breakdowns from the sprint workspace and creates / updates work items via the Azure DevOps REST API.",
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "dotenv": "^17.2.3"
  }
}
